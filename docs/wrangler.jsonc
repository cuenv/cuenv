{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cuenv-website",
	"compatibility_date": "2026-11-03",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "cuenv.dev",
			"custom_domain": true
		}
	],
	// Pull requests deploy to a Worker Preview (`wrangler preview`), served at
	// pr-<number>-cuenv-website.<subdomain>.workers.dev. Production stays on
	// the cuenv.dev custom domain; `previews` holds preview-only overrides.
	"preview_urls": true,
	"previews": {},
	"observability": {
		"enabled": true
	}
}
