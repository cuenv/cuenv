{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cuenv-website",
	"compatibility_date": "2026-11-03",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "cuenv.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
